#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define SYS  3

// -----------------------------------------------------------------------------------------
//  BEHAVIORS
// -----------------------------------------------------------------------------------------

/ {
    behaviors {
        // CUSTOM HOLD-TAP: "Hold for Symbol A, Tap for Symbol B"
        // Usage: &ht HOLD_KEY TAP_KEY

        ht: custom_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_SYMBOLS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };
};

// Configuration for standard Mod-Taps (Shift/Ctrl/etc)

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

// Configuration for Layer-Taps (Thumb keys)

&lt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    macros {
        // Macro: Redo (Cmd + Shift + Z)

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LGUI &kp LSHFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_sys_layer {
            bindings = <&to SYS>;
            key-positions = <20 31>;
        };

        // Exclamation Mark ! (Keys F + P)

        combo_excl {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp EXCL>;
        };

        // Question Mark ? (Keys L + U)

        combo_qmark {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&kp QMARK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ---------------------------------------------------------------------------------------------------------------------------
        // LAYER 0: BASE (Colemak-DH)

        base_layer {
            label = "BASE";
            bindings = <
       &kp Q       &kp W       &kp F        &kp P        &kp B        &kp J    &kp L        &kp U        &kp Y       &kp SEMI
       &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G        &kp M    &mt RSHFT N  &mt RCTRL E  &mt RALT I  &mt RGUI O
&none  &kp Z       &kp X       &kp C        &kp D        &kp V        &kp K    &kp H        &kp COMMA    &kp DOT     &kp FSLH    &none
                               &kp DEL      &lt NAV TAB  &kp SPACE    &kp RET  &lt SYM ESC  &kp BSPC
            >;
        };

        // ---------------------------------------------------------------------------------------------------------------------------
        // LAYER 1: NAV (Navigation, Editing, and Media)

        nav_layer {
            label = "NAV";
            bindings = <
       &kp ESC        &kp LG(X)      &kp LG(C)   &kp LG(V)   &redo        &kp PG_UP   &kp HOME      &kp END       &kp CAPS  &none
       &kp LGUI       &kp LALT       &kp LCTRL   &kp LSHFT   &kp LG(Z)    &kp PG_DN   &kp LEFT      &kp DOWN      &kp UP    &kp RIGHT
&none  &kp C_BRI_DEC  &kp C_BRI_INC  &kp C_PREV  &kp C_NEXT  &kp C_PP     &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none     &none      &none
                                     &trans      &trans      &trans       &trans      &trans        &trans
            >;
        };

        // ---------------------------------------------------------------------------------------------------------------------------
        // LAYER 2: SYM (Code & Numbers)
        // Using &ht (Hold-Tap) instead of &mt
        // Usage: &ht HOLD_KEY TAP_KEY

        sym_layer {
            label = "SYM";
            bindings = <
       &ht TILDE DLLR  &kp LBRC       &kp RBRC        &kp DQT           &ht BSLH PIPE     &kp PLUS   &kp N7         &kp N8        &kp N9       &kp STAR
       &ht LGUI GRAVE  &mt LALT LPAR  &mt LCTRL RPAR  &mt LSHIFT UNDER  &kp HASH          &kp MINUS  &mt RSHIFT N4  &mt RCTRL N5  &mt RALT N6  &mt RGUI N0
&none  &ht PRCNT AT    &kp LBKT       &kp RBKT        &kp SQT           &mt CARET AMPS    &kp EQUAL  &kp N1         &kp N2        &kp N3       &kp FSLH     &none
                                      &trans          &trans            &trans            &trans     &trans         &trans
            >;
        };

        // ---------------------------------------------------------------------------------------------------------------------------
        // LAYER 3: SYS (Hardware)

        sys_layer {
            label = "SYS";
            bindings = <
       &none  &none  &none  &none       &bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &none  &none  &kp S  &none       &none          &none         &none         &kp S         &none         &none
&none  &none  &none  &none  &sys_reset  &bootloader    &bootloader   &sys_reset    &none         &none         &none         &none
                     &none  &none       &to 0          &to 0         &none         &trans
            >;
        };
    };
};